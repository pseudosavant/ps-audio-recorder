# ReplayGain Watcher environment overrides

# Path to watch (default /srv/recordings)
#WATCH_PATH=/srv/recordings

# Recursive watch: 1=yes, 0=no (default 1)
#RECURSIVE=1

# Log verbosity: debug|info|error (default info)
#LOG_LEVEL=info

# Processing mode: track|album (default track)
#PROCESS_MODE=track

# Exclude regex for temporary/partial files (default covers .partial, .part, .tmp)
#EXCLUDE_REGEX='(\.partial$|\.part$|\.tmp$)'

# Resource knobs (defaults suitable for Pi Zero 2 W)
#NICE_LEVEL=15
#IONICE_CLASS=3
