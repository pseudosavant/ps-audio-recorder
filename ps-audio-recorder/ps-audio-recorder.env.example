# ps-audio-recorder environment overrides
# Copy to: /etc/ps-audio-recorder/ps-audio-recorder.env
# Loaded by: ps-audio-recorder.service (EnvironmentFile)

# Audio capture
#PS_AUDIO_SAMPLE_RATE=48000
#PS_AUDIO_CHANNELS=2
#PS_AUDIO_AUDIO_FORMAT=S32_LE
#PS_AUDIO_RECORDING_EXTENSION=mp3
#PS_AUDIO_MAX_RECORDING_TIME=3600

# Input / trigger
#PS_AUDIO_TRIGGER_KEY_CODE=115

# Paths and filenames
#PS_AUDIO_RECORDING_DIR=/srv/recordings
#PS_AUDIO_RECORDING_PREFIX=audio-recorder
#PS_AUDIO_TIMESTAMP_FORMAT=%Y-%m-%d-%H-%M-%S
#PS_AUDIO_LOG_FILE=/var/log/audio-recorder.log

# Kasa bulb behavior
#PS_AUDIO_BULB_NAME=Recording Light
#PS_AUDIO_BULB_CACHE_FILE=/var/lib/audio-recorder/last_bulb.json
#PS_AUDIO_BULB_DISCOVERY_TIMEOUT=8
#PS_AUDIO_BULB_REDISCOVERY_INTERVAL=300

# Recording light color / command pacing
#PS_AUDIO_RECORDING_HUE=0
#PS_AUDIO_RECORDING_SATURATION=100
#PS_AUDIO_RECORDING_BRIGHTNESS=100
#PS_AUDIO_POWER_COMMAND_DELAY=1.2
#PS_AUDIO_COLOR_COMMAND_DELAY=1.1
#PS_AUDIO_BRIGHTNESS_COMMAND_DELAY=1.0
